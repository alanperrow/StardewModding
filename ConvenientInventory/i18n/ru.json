  // ModConfigMenu
  "ModConfigMenu.Label.QuickStackToNearbyChests": "Распределение по ближайшим сундукам",

  "ModConfigMenu.IsEnableQuickStack.Name": "Включить быстрое распределение?",
  "ModConfigMenu.IsEnableQuickStack.Desc": "Если включено, добавляет кнопку \"Разложить по ближайшим сундукам\" в меню вашего инвентаря. Нажатие на эту кнопку распределит предметы из вашего инвентаря в любые ближайшие сундуки, которые содержат данный предмет.",

  "ModConfigMenu.IsEnableQuickStackHotkey.Name": "Включить горячие клавиши?",
  "ModConfigMenu.IsEnableQuickStackHotkey.Desc": "Если включено, нажатие любой из горячих клавиш быстрого распределения, указанных ниже, быстро распределит ваши предметы, даже вне меню вашего инвентаря.",

  "ModConfigMenu.QuickStackKeyboardHotkey.Name": "Горячая клавиша (клавиатура)",
